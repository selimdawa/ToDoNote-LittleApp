<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.MainApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorControlActivated">@color/dark</item>
        <item name="checkboxStyle">@style/Widget.App.CheckBox</item>
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/basic_2</item>
        <item name="colorAccent">@color/basic_2</item>
        <item name="color">@color/white</item>
        <item name="background">@color/basic_2</item>
        <item name="tickColor">@color/basic_2</item>
        <item name="trackColor">@color/basic_2</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorError">@color/dark</item>
        <item name="colorOnError">@color/basic_2</item>
    </style>

    <style name="Theme.MainApp" parent="Base.Theme.MainApp" />

    <!-- Define the checkbox specific theme override -->
    <style name="Widget.App.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <!-- This will tint the checkbox to black -->
        <item name="buttonTint">@color/dark</item>
    </style>

</resources>